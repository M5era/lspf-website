# Sanity — public project ID, dataset name.
# Project IDs are not secret (they appear in CDN URLs).
PUBLIC_SANITY_PROJECT_ID=nsxw1yrt
PUBLIC_SANITY_DATASET=production

# Use the Sanity CDN for reads (cached, faster). Set to "false" for live, uncached reads.
PUBLIC_SANITY_USE_CDN=true

# Set to "true" to make Astro pages fetch from Sanity instead of placeholders.
# Loaders auto-fall-back to placeholders for any content type Sanity returns
# empty, so flipping this on with an empty CMS is safe.
USE_SANITY=true

# Required only for `npm run seed`. Generate a write token at:
# https://www.sanity.io/manage/project/nsxw1yrt/api → Tokens → Add API token
# (Editor permission). Not needed for normal site operation.
# SANITY_AUTH_TOKEN=sk_paste_token_here
