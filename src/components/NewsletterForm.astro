---
const action = "https://example.com/newsletter-placeholder";
---

<form
  action={action}
  method="post"
  class="flex flex-col sm:flex-row gap-3 max-w-md"
  data-newsletter
>
  <label for="newsletter-email" class="sr-only">Email address</label>
  <input
    id="newsletter-email"
    name="email"
    type="email"
    required
    placeholder="Enter your email address"
    class="flex-1 px-4 py-3 border border-[color:var(--color-rule)] focus:outline-none focus:border-[color:var(--color-ink)] text-sm bg-white"
  />
  <button
    type="submit"
    class="px-5 py-3 bg-[color:var(--color-ink)] text-[color:var(--color-paper)] text-sm font-medium hover:bg-[color:var(--color-hover)] transition-colors"
  >
    Sign up
  </button>
</form>
