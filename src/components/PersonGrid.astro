---
import type { Person } from "@/data/types";

interface Props {
  people: Person[];
  columns?: 3 | 4;
}

const { people, columns = 4 } = Astro.props;
const colClass =
  columns === 3
    ? "grid-cols-2 sm:grid-cols-3"
    : "grid-cols-2 sm:grid-cols-3 lg:grid-cols-4";
---

<div class={`grid gap-x-6 gap-y-10 ${colClass}`}>
  {
    people.map((p) => {
      const inner = (
        <>
          {p.portrait && (
            <div class="overflow-hidden bg-black/5 mb-3 aspect-square">
              <img
                src={p.portrait.src}
                alt={p.portrait.alt}
                class="w-full h-full object-cover"
                loading="lazy"
              />
            </div>
          )}
          <p class="text-sm text-[color:var(--color-ink)]">{p.name}</p>
          {p.subtitle && (
            <p class="text-xs text-[color:var(--color-muted)]">{p.subtitle}</p>
          )}
        </>
      );
      return p.url ? (
        <a
          href={p.url}
          target="_blank"
          rel="noopener noreferrer"
          class="group block"
        >
          {inner}
        </a>
      ) : (
        <div>{inner}</div>
      );
    })
  }
</div>
