---
// Shown at the top of every /preview/* page to make it obvious this is not
// the public site. The banner doesn't break the layout — it just sits on top.
---

<style is:inline>
  body {
    padding-top: 42px !important;
  }
</style>

<div
  style="position:fixed;top:0;left:0;right:0;z-index:1000;background:#111;color:#fff;padding:10px 16px;font-family:'Inter',sans-serif;font-size:13px;display:flex;justify-content:space-between;align-items:center;border-bottom:2px solid #d64545;"
>
  <span>
    <strong style="color:#d64545;">PREVIEW MODE</strong>
    <span style="opacity:0.7;margin-left:8px;">Shows unpublished drafts from Sanity. Edits appear on next refresh.</span>
  </span>
  <a
    href="javascript:location.reload()"
    style="color:#fff;border:1px solid #fff;padding:4px 12px;text-decoration:none;font-size:12px;"
  >Refresh</a>
</div>
