---
import type { Sponsor } from "@/data/types";

interface Props {
  sponsors: Sponsor[];
}
const { sponsors } = Astro.props;
---

<div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-x-8 gap-y-12 items-center">
  {
    sponsors.map((s) => {
      const inner = (
        <>
          {s.logo && (
            <img
              src={s.logo.src}
              alt={s.logo.alt}
              class="max-h-16 w-auto object-contain mx-auto opacity-70 group-hover:opacity-100 transition-opacity"
              loading="lazy"
            />
          )}
          {s.tier && (
            <p class="mt-3 text-[10px] uppercase tracking-[0.18em] text-center text-[color:var(--color-muted)]">
              {s.tier}
            </p>
          )}
        </>
      );
      return s.url ? (
        <a
          href={s.url}
          target="_blank"
          rel="noopener noreferrer"
          class="group block text-center"
        >
          {inner}
        </a>
      ) : (
        <div class="group text-center">{inner}</div>
      );
    })
  }
</div>
