---
import Base from "@/layouts/Base.astro";
import PortableText from "@/components/PortableText.astro";
import { getPage } from "@/lib/loaders";
import { site } from "@/data/site";

const page = await getPage("about");

const fallbackBlocks = [
  {
    _type: "block",
    style: "h2",
    children: [{ _type: "span", text: "About the Festival" }],
  },
  {
    _type: "block",
    style: "normal",
    children: [
      {
        _type: "span",
        text: "Lisbon Street Photo Fest is organised by Associação 351 Foto, an independent non-profit based in Lisbon, Portugal. Focused on celebrating street photography, the festival offers exhibitions, talks, photowalks, portfolio reviews, and workshops, fostering creative exchange between photographers from around the world. The festival takes place at the Faculty of Fine Arts of the University of Lisbon.",
      },
    ],
  },
];

const blocks = page?.body ?? fallbackBlocks;
---

<Base
  title="About"
  description="About Lisbon Street Photo Fest and Associação 351 Foto."
>
  <article class="mx-auto max-w-3xl px-6 lg:px-12 pt-12 pb-24">
    <p class="uppercase tracking-[0.16em] text-xs text-[color:var(--color-muted)] mb-4">
      About
    </p>
    <h1 class="h-display text-4xl sm:text-5xl mb-10">
      Rooted in Lisbon. Open to the world.
    </h1>

    <div class="prose-festival text-[color:var(--color-ink)]/85">
      <PortableText blocks={blocks} />
    </div>

    <section class="mt-16 pt-10 border-t border-[color:var(--color-rule)]">
      <h2 class="h-section text-2xl mb-4">Get in touch</h2>
      <p class="leading-relaxed mb-4">
        Press, partnerships, or general inquiries:
      </p>
      <p class="text-lg">
        <a
          href={`mailto:${site.contactEmail}`}
          class="link-quiet"
        >
          {site.contactEmail}
        </a>
      </p>
      <p class="mt-3">
        <a
          href={site.instagram}
          target="_blank"
          rel="noopener noreferrer"
          class="link-quiet"
        >
          Instagram →
        </a>
      </p>
    </section>
  </article>
</Base>
