---
import Base from "@/layouts/Base.astro";
import Hero from "@/components/Hero.astro";
import { getCurrentEdition, getWorkshops, getFinalistSingles } from "@/lib/loaders";

const currentEdition = await getCurrentEdition();
const workshops = await getWorkshops();
const allSingles = await getFinalistSingles(2025);
// Show the three winners on the home page as a teaser.
const winnerLabels = ["Winner (1st place)", "2nd place", "3rd place"];
const winners = winnerLabels
  .map((label) => allSingles.find((f) => f.award === label))
  .filter((f): f is NonNullable<typeof f> => Boolean(f));

const fmtMonth = (iso: string) =>
  new Date(iso).toLocaleDateString("en-GB", { month: "long" });

const startDay = new Date(currentEdition.startDate).getDate();
const endDay = new Date(currentEdition.endDate).getDate();
const month = fmtMonth(currentEdition.startDate);
const year = currentEdition.year;
---

<Base title="Home" ogImage={currentEdition.heroImage.src}>
  <Hero
    image={currentEdition.heroImage}
    eyebrow={`${startDay}–${endDay} ${month} ${year}`}
    title={currentEdition.tagline}
    subtitle="The second edition of Lisbon Street Photo Fest brings together photographers, enthusiasts, and curious minds from around the world."
    ctaLabel="2026 Open Call — Submit"
    ctaHref={currentEdition.openCallUrl}
  />

  <section class="mx-auto max-w-7xl px-6 lg:px-10 py-20 lg:py-28">
    <div class="grid gap-12 lg:grid-cols-[1fr_2fr] lg:gap-20 items-start">
      <h2 class="h-display text-3xl sm:text-4xl">
        Join us for the second edition.
      </h2>
      <p class="text-lg leading-relaxed text-[color:var(--color-ink)]/85">
        {currentEdition.intro}
      </p>
    </div>
  </section>

  <section class="border-t border-[color:var(--color-rule)] bg-white">
    <div class="mx-auto max-w-7xl px-6 lg:px-10 py-20 grid gap-12 md:grid-cols-2 lg:grid-cols-4">
      <div>
        <h3 class="h-display text-xl mb-3">Open Call</h3>
        <p class="text-sm text-[color:var(--color-muted)] leading-relaxed">
          Until 31 May, our contests are open to street photography submissions
          from around the world. Finalists are selected by an independent jury.
        </p>
      </div>
      <div>
        <h3 class="h-display text-xl mb-3">Free &amp; open to the public</h3>
        <p class="text-sm text-[color:var(--color-muted)] leading-relaxed">
          Finalists' work takes over the Faculdade de Belas-Artes exhibition
          venues, creating a space for discovery and dialogue.
        </p>
      </div>
      <div>
        <h3 class="h-display text-xl mb-3">Activities</h3>
        <p class="text-sm text-[color:var(--color-muted)] leading-relaxed">
          A weekend of workshops, photowalks, portfolio reviews, and talks
          designed to inspire and challenge.
        </p>
      </div>
      <div>
        <h3 class="h-display text-xl mb-3">Connect through passion</h3>
        <p class="text-sm text-[color:var(--color-muted)] leading-relaxed">
          Immerse yourself in the city, connect with fellow photographers, and
          engage with the community.
        </p>
      </div>
    </div>
  </section>

  {
    winners.length > 0 && (
      <section class="border-t border-[color:var(--color-rule)]">
        <div class="mx-auto max-w-[1400px] px-6 lg:px-12 py-20">
          <div class="flex items-end justify-between mb-10">
            <div>
              <p class="uppercase tracking-[0.16em] text-xs text-[color:var(--color-muted)] mb-2">
                2025 Open Call
              </p>
              <h2 class="h-display text-3xl sm:text-4xl">Winners &amp; finalists</h2>
            </div>
            <a
              href="/2025-winners/singles"
              class="link-quiet text-sm"
            >
              See all →
            </a>
          </div>

          <div class="grid gap-8 md:grid-cols-3">
            {winners.map((w) => (
              <a
                href="/2025-winners/singles"
                class="group block"
              >
                <div class="overflow-hidden bg-black/5 mb-3">
                  <img
                    src={w.image.src}
                    alt={w.image.alt}
                    class="w-full h-auto object-cover aspect-[3/2] transition-transform duration-500 group-hover:scale-[1.02]"
                    loading="lazy"
                  />
                </div>
                <p class="text-[10px] uppercase tracking-[0.18em] text-[color:var(--color-muted)] mb-1">
                  {w.award}
                </p>
                <p class="text-base">{w.photographer}</p>
                {w.caption && (
                  <p class="text-sm text-[color:var(--color-muted)] italic mt-1">
                    {w.caption}
                  </p>
                )}
              </a>
            ))}
          </div>

          <div class="mt-10 flex flex-wrap gap-x-8 gap-y-2 text-sm">
            <a href="/2025-winners/series" class="link-quiet">
              Series finalists →
            </a>
            <a href="/2025-winners/exhibitions" class="link-quiet">
              2025 Exhibitions →
            </a>
          </div>
        </div>
      </section>
    )
  }

  <section class="mx-auto max-w-[1400px] px-6 lg:px-12 py-20 lg:py-28">
    <div class="flex items-end justify-between mb-10">
      <h2 class="h-display text-3xl sm:text-4xl">Featured activities</h2>
      <a
        href="/activities"
        class="text-sm underline underline-offset-4 hover:text-[color:var(--color-accent)]"
        >See all →</a
      >
    </div>

    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        workshops.slice(0, 3).map((w) => (
          <a
            href={`/activities#${w.slug}`}
            class="group block overflow-hidden rounded-md bg-white border border-[color:var(--color-rule)] hover:border-[color:var(--color-ink)] transition-colors"
          >
            <div class="aspect-[16/10] overflow-hidden bg-black/5">
              <img
                src={w.cover.src}
                alt={w.cover.alt}
                class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
                loading="lazy"
              />
            </div>
            <div class="p-5">
              <p class="text-[10px] uppercase tracking-[0.18em] text-[color:var(--color-muted)] mb-1">
                {w.kind.replace("-", " ")}
              </p>
              <h3 class="font-display text-lg mb-1">{w.title}</h3>
              <p class="text-sm text-[color:var(--color-muted)]">
                {w.instructor}
              </p>
              <p class="mt-3 text-sm">
                {w.priceEUR === 0 ? "Free" : `€${w.priceEUR}`}
              </p>
            </div>
          </a>
        ))
      }
    </div>
  </section>
</Base>
